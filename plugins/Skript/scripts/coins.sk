options:
  prefix: "&6[Coins]&r "

command /coins [<player>]:
  trigger:
    if arg-1 is set:
      if player has permission "coins.view.others":
        set {_bal} to balance of arg-1
        send "{@prefix}&e%arg-1%&7 balance: &e%{_bal}%"
      else:
        send "{@prefix}&cNo permission."
    else:
      set {_bal} to balance of player
      send "{@prefix}&7Your balance: &e%{_bal}%"

command /coins pay <player> <number>:
  trigger:
    if arg-2 <= 0:
      send "{@prefix}&cAmount must be at least 1."
      stop
    if balance of player < arg-2:
      send "{@prefix}&cNot enough coins."
      stop
    remove arg-2 from balance of player
    add arg-2 to balance of arg-1
    send "{@prefix}&7You sent &e%arg-2%&7 to &e%arg-1%&7."
    send "{@prefix}&7You received &e%arg-2%&7 from &e%player%&7." to arg-1

command /coins give <player> <number>:
  permission: coins.admin
  permission message: "{@prefix}&cNo permission."
  trigger:
    if arg-2 <= 0:
      send "{@prefix}&cAmount must be at least 1."
      stop
    add arg-2 to balance of arg-1
    send "{@prefix}&7Added &e%arg-2%&7 to &e%arg-1%&7."
    send "{@prefix}&7You received &e%arg-2%&7 coins." to arg-1

command /coins take <player> <number>:
  permission: coins.admin
  permission message: "{@prefix}&cNo permission."
  trigger:
    if arg-2 <= 0:
      send "{@prefix}&cAmount must be at least 1."
      stop
    remove arg-2 from balance of arg-1
    send "{@prefix}&7Removed &e%arg-2%&7 from &e%arg-1%&7."
    send "{@prefix}&7%arg-2%&7 coins were removed." to arg-1

command /coinstop:
  trigger:
    execute player command "baltop"
