command /coins [<text>] [<text>] [<number>]:
  trigger:
    # Message prefix
    set {_p} to "&6[Coins]&r "

    # /coins - show your balance
    if arg-1 is not set:
      set {_bal} to balance of player
      send "%{_p}%&7Your balance: &e%{_bal}%"
      stop

    # /coins pay <player> <amount> - transfer coins
    if arg-1 is "pay":
      if arg-2 is not set or arg-3 is not set:
        send "%{_p}%&cUsage: /coins pay <player> <amount>"
        stop
      set {_t} to offline player named arg-2
      if {_t} is not set:
        send "%{_p}%&cPlayer not found."
        stop
      if {_t} is player:
        send "%{_p}%&cYou can't pay yourself."
        stop
      if arg-3 <= 0:
        send "%{_p}%&cAmount must be at least 1."
        stop
      if balance of player < arg-3:
        send "%{_p}%&cNot enough coins."
        stop
      remove arg-3 from balance of player
      add arg-3 to balance of {_t}
      send "%{_p}%&7You sent &e%arg-3%&7 to &e%{_t}%&7."
      if {_t} is online:
        send "%{_p}%&7You received &e%arg-3%&7 from &e%player%&7." to {_t}
      stop

    # /coins give <player> <amount> - admin adds coins
    if arg-1 is "give":
      if player does not have permission "coins.admin":
        send "%{_p}%&cNo permission."
        stop
      if arg-2 is not set or arg-3 is not set:
        send "%{_p}%&cUsage: /coins give <player> <amount>"
        stop
      set {_t} to offline player named arg-2
      if {_t} is not set:
        send "%{_p}%&cPlayer not found."
        stop
      if arg-3 <= 0:
        send "%{_p}%&cAmount must be at least 1."
        stop
      add arg-3 to balance of {_t}
      send "%{_p}%&7Added &e%arg-3%&7 to &e%{_t}%&7."
      if {_t} is online:
        send "%{_p}%&7You received &e%arg-3%&7 coins." to {_t}
      stop

    # /coins take <player> <amount> - admin removes coins
    if arg-1 is "take":
      if player does not have permission "coins.admin":
        send "%{_p}%&cNo permission."
        stop
      if arg-2 is not set or arg-3 is not set:
        send "%{_p}%&cUsage: /coins take <player> <amount>"
        stop
      set {_t} to offline player named arg-2
      if {_t} is not set:
        send "%{_p}%&cPlayer not found."
        stop
      if arg-3 <= 0:
        send "%{_p}%&cAmount must be at least 1."
        stop
      remove arg-3 from balance of {_t}
      send "%{_p}%&7Removed &e%arg-3%&7 from &e%{_t}%&7."
      if {_t} is online:
        send "%{_p}%&7%arg-3%&7 coins were removed." to {_t}
      stop

    # /coins <player> - show another player's balance (needs coins.view.others)
    set {_t} to offline player named arg-1
    if {_t} is not set:
      send "%{_p}%&cPlayer not found."
      stop
    if player has permission "coins.view.others":
      set {_bal} to balance of {_t}
      send "%{_p}%&e%{_t}%&7 balance: &e%{_bal}%"
    else:
      send "%{_p}%&cNo permission."

# /coinstop - show top balances (runs /baltop)
command /coinstop:
  trigger:
    execute player command "baltop"
